# Copie para .env e ajuste se necessário. Nenhum segredo real deve ser versionado.

PORT=3000
SERVICE_NAME=wagering-processor

# PostgreSQL (docker-compose)
DB_HOST=localhost
DB_PORT=5433
DB_USER=jungle
DB_PASSWORD=jungle
DB_NAME=junglegaming

# Referências fora de ordem (Etapa 5). Padrões em src/domain/wagering/reference-retry-policy.ts.
# PENDING_REFERENCE_POLL_MS=1000
# PENDING_REFERENCE_BATCH_SIZE=50
# PENDING_REFERENCE_MAX_ATTEMPTS=10
# PENDING_REFERENCE_TTL_MS=86400000
# PENDING_REFERENCE_BASE_DELAY_MS=1000
# PENDING_REFERENCE_MAX_DELAY_MS=300000

# Outbox (Etapa 7)
# OUTBOX_POLL_MS=500
# OUTBOX_BATCH_SIZE=50
# OUTBOX_MAX_BACKOFF_MS=300000
# EVENTS_QUEUE_NAME=wager-events

# Consumidor SQS (Etapa 8)
# WAGER_CONSUMER_ENABLED=1
# SQS_WAGER_QUEUE=wager-transactions.fifo
# SQS_WAGER_DLQ=wager-transactions-dlq.fifo
# SQS_WAIT_SECONDS=10
# SQS_MAX_MESSAGES=10
# SQS_MAX_RECEIVE_COUNT=5
# SQS_RETRY_BASE_SECONDS=5
# SQS_RETRY_MAX_SECONDS=900
# SHUTDOWN_GRACE_MS=10000

# LocalStack (SQS)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

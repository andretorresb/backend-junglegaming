{
  "name": "backend-junglegaming",
  "version": "0.1.0",
  "private": true,
  "description": "Distributed Wagering Processor — desafio técnico Jungle Gaming",
  "type": "module",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun build src/main.ts --target bun --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "migration:create": "MIKRO_ORM_CLI_CONFIG=mikro-orm.config.ts bun ./node_modules/@mikro-orm/cli/index.js migration:create",
    "migration:up": "MIKRO_ORM_CLI_CONFIG=mikro-orm.config.ts bun ./node_modules/@mikro-orm/cli/index.js migration:up",
    "migration:down": "MIKRO_ORM_CLI_CONFIG=mikro-orm.config.ts bun ./node_modules/@mikro-orm/cli/index.js migration:down"
  },
  "dependencies": {
    "@mikro-orm/core": "^6.4.0",
    "@mikro-orm/migrations": "^6.4.0",
    "@mikro-orm/nestjs": "^6.1.0",
    "@mikro-orm/postgresql": "^6.4.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "decimal.js": "^10.4.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.4.0",
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
